{
    "services": [
        "lua ~/.config/scripts/launch.lua",
        "elephant",
        "walker --gapplication-service",
        "wlsunset -l 53.36681292618379 -L 14.650595233724927",
        "wl-paste --watch cliphist store",
        "mako"
    ],
    "one_time": [
        "awww img ~/.config/wallpapers/everforest_anime_girl_1.png --transition-fps 255 --transition-step 10",
        "awww img ~/.config/wallpapers/everforest_anime_girl_2.png --transition-fps 255 --transition-step 10 -o DP-3",
        "awww img ~/.config/wallpapers/everforest_shapes.png       --transition-fps 255 --transition-step 10 -o HDMI-A-1",
        "echo 'everforest' > ~/.config/rice/nvim_theme"
    ]
}
